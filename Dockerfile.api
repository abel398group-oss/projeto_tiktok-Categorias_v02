# API analytics (Fastify + Prisma) + coleta opcional (Puppeteer com Chromium do sistema).
# PUPPETEER_SKIP_DOWNLOAD=1 evita o download pesado do Chrome no `npm ci`; usa-se o pacote Debian `chromium`.
FROM node:20-bookworm-slim AS base
WORKDIR /app

# Camada única apt (cache Docker): TLS/OpenSSL + runtime headless do Chromium em slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    openssl \
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY . .

RUN chmod +x deploy/docker-api-entrypoint.sh \
  && npx prisma generate

ENV NODE_ENV=production
EXPOSE 3333

ENTRYPOINT ["/app/deploy/docker-api-entrypoint.sh"]
