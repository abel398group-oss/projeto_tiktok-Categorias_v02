# -----------------------------------------------------------------------------
# DATABASE_URL — OBRIGATÓRIO. Não committar este ficheiro preenchido com segredos.
#
# DigitalOcean Managed PostgreSQL (porta 25060, TLS):
#   postgresql://doadmin:SENHA@db-postgresql-....db.ondigitalocean.com:25060/product_search_398?schema=public&sslmode=require
# Se a SENHA tiver @ : / ? # ou espaços, codifica-a (ex. em Node: encodeURIComponent(pw)).
#
# Local típico (Docker Postgres na porta 5432) mantém o modelo com HOST:5432.
# Erro "Can't reach ... :5432" com DO → normalmente falta ?sslmode=require, porta errada ou firewall.
# No Droplet: DigitalOcean → Databases → Trusted sources → incluir o Droplet (ou IP público).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Servidor analytics:api — ANALYTICS_API_KEY obrigatória ao subir `npm run analytics:api` (sem linha válida o processo termina).
# POST `/analytics/export-product-to-spaces` no mesmo servidor exige também SPACES_* activas neste `.env`.
# Em produção (Nginx + systemd) usa 127.0.0.1 — o proxy fala com a API na mesma máquina.
ANALYTICS_API_KEY=troca-por-uma-chave-local-secreta
ANALYTICS_API_HOST=127.0.0.1
ANALYTICS_API_PORT=3333

# Docker Compose (`docker compose up --build`): o build do frontend lê esta variável a partir da raiz.
# Define com o MESMO valor que ANALYTICS_API_KEY (ver docs/DOCKER.md).
# VITE_ANALYTICS_API_KEY=
#
# Docker Compose: porta pública do contentor `web` (host → Nginx interno 80). Defeito 8080 se a porta 80 do host estiver ocupada (ex.: Nginx/EasyPanel).
# COMPOSE_WEB_PORT=8080
# COMPOSE_WEB_PORT=80

# DigitalOcean Spaces — teste: `npm run test:spaces`
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_REGION=nyc3
# SPACES_BUCKET=nome-do-space
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
# SPACES_BASE_PATH= (modo EXPORT_SPACES_FLAT apenas)
# CDN / origin — URL impressa pelos scripts quando definida:
# SPACES_PUBLIC_BASE_URL=https://nome-do-space.nyc3.cdn.digitaloceanspaces.com
#
# Leitura pública dos ficheiros pelo URL (browser). Sem isto: AccessDenied ao abrir no Chrome.

# SPACES_OBJECTS_PUBLIC_READ=1
#
# Prefixo opcional antes de tiktok-shop (vazio por defeito — sem pasta "product-research").
# Para o layout antigo: SPACES_EXPORT_ROOT=product-research
# SPACES_EXPORT_ROOT=
# SPACES_EXPORT_PLATFORM=tiktok-shop
# SPACES_TEST_CATEGORY_SLUG=demo-categoria
# SPACES_TEST_PRODUCT_NAME=produto-demo
# SPACES_TEST_PRODUCT_ID=test-local-001
# EXPORT_SPACES_FLAT=1
#
# Export produto → Spaces (CLI): npm run export:product-spaces -- --product-id <TIKTOK_PRODUCT_ID>
# ZIP de fotos no workspace (API): servidor — opcional:
# WORKSPACE_IMAGE_ZIP_MAX_BYTES=15728640
# WORKSPACE_IMAGE_ZIP_TIMEOUT_MS=25000
# EXPORT_IMAGE_MAX=15
# EXPORT_IMAGE_MAX_BYTES=12582912
# EXPORT_IMAGE_TIMEOUT_MS=25000
