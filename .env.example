DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Servidor analytics:api — ANALYTICS_API_KEY obrigatória ao subir `npm run analytics:api` (sem linha válida o processo termina).
ANALYTICS_API_KEY=troca-por-uma-chave-local-secreta
# ANALYTICS_API_HOST=127.0.0.1
# ANALYTICS_API_PORT=3333

# DigitalOcean Spaces — teste: `npm run test:spaces`
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_REGION=nyc3
# SPACES_BUCKET=nome-do-space
# SPACES_ACCESS_KEY_ID=
# SPACES_SECRET_ACCESS_KEY=
# SPACES_BASE_PATH=product-research
# Opcional — URL base pública/CDN para eco no script (senão monta *.digitaloceanspaces.com):
# SPACES_PUBLIC_BASE_URL=https://nome-do-space.nyc3.cdn.digitaloceanspaces.com
#
# Árvore de export (npm run test:spaces): root / plataforma / categoria / produtoSlug__productId /
# SPACES_EXPORT_ROOT=product-research
# SPACES_EXPORT_PLATFORM=tiktok-shop
# SPACES_TEST_CATEGORY_SLUG=demo-categoria
# SPACES_TEST_PRODUCT_NAME=produto-demo
# SPACES_TEST_PRODUCT_ID=test-local-001
# EXPORT_SPACES_FLAT=1
