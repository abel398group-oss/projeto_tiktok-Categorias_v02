{
  "name": "projeto-tiktok-categorias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run coleta:completa:db && npm run analytics:product-score",
    "test": "node --test test/scrape-regression.test.mjs test/opportunities-no-sales.test.mjs test/enrichment-flag.test.mjs test/checkpoint-falhas.test.mjs test/crescimento-por-dia.test.mjs test/rendimento-fila.test.mjs test/completude-coleta.test.mjs test/estatisticas-categoria.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:schemas": "node scripts/validate-output-schema.mjs",
    "validate:schemas:ci": "node scripts/validate-output-schema.mjs --data-dir test/fixtures/schema-ci",
    "setup:local": "node scripts/setup-local-env.mjs",
    "db:check": "node scripts/check-database-connection.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:docker:ensure-url": "node scripts/ensure-local-database-url.mjs",
    "db:docker:up": "docker compose -f docker-compose.postgres-local.yml up -d",
    "db:docker:down": "docker compose -f docker-compose.postgres-local.yml down",
    "db:docker:wait": "node scripts/wait-tcp.mjs 127.0.0.1 5433",
    "db:docker:bootstrap": "node scripts/ensure-local-database-url.mjs && docker compose -f docker-compose.postgres-local.yml up -d && node scripts/wait-tcp.mjs 127.0.0.1 5433 && npx prisma migrate deploy && npx prisma generate",
    "pdp:enrich": "node --import ./scripts/load-root-env.mjs scripts/pdp-enrich-products.mjs",
    "images:upload": "node --import ./scripts/load-root-env.mjs scripts/images-upload.mjs",
    "validate:db-vs-json": "node --import ./scripts/load-root-env.mjs scripts/validate-db-vs-json.mjs",
    "analytics:top-products": "node --import ./scripts/load-root-env.mjs scripts/analytics/top-products.mjs",
    "analytics:new-products": "node --import ./scripts/load-root-env.mjs scripts/analytics/new-products.mjs",
    "analytics:growth": "node --import ./scripts/load-root-env.mjs scripts/analytics/growth.mjs",
    "analytics:opportunities": "node --import ./scripts/load-root-env.mjs scripts/analytics/opportunities.mjs",
    "analytics:product-score": "node --import ./scripts/load-root-env.mjs scripts/analytics/product-score.mjs",
    "analytics:decision": "node --import ./scripts/load-root-env.mjs scripts/analytics/product-decision-cli.mjs",
    "analytics:scalable": "node --import ./scripts/load-root-env.mjs scripts/analytics/scalable-products-cli.mjs",
    "analytics:category-map": "node --import ./scripts/load-root-env.mjs scripts/analytics/category-map-cli.mjs",
    "analytics:api": "node --import ./scripts/load-root-env.mjs scripts/analytics/server.mjs",
    "api:dev": "node --watch --import ./scripts/load-root-env.mjs scripts/analytics/server.mjs",
    "dev:ollama": "node scripts/dev/start-ollama.mjs",
    "dev": "npm run dev:ollama && npm run api:dev",
    "frontend:dev": "cd frontend && npm run dev",
    "dev:app": "concurrently -n API,FRONT -c green,blue \"npm run api:dev\" \"npm run frontend:dev\"",
    "dev:all": "npm run db:docker:up && npm run db:docker:wait && concurrently -n API,FRONT -c green,blue \"npm run api:dev\" \"npm run frontend:dev\"",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "db:import:output": "node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "coleta": "node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:db": "node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "coleta:uma": "node src/scrapeCategory.mjs",
    "coleta:uma:db": "node src/scrapeCategory.mjs && node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "coleta:uma:completa": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs",
    "coleta:uma:completa:db": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs && node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "coleta:completa": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:completa:db": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "coleta:completa:login": "cross-env HEADED=1 PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:completa:login:db": "cross-env HEADED=1 PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node --import ./scripts/load-root-env.mjs scripts/import-output-to-db.mjs",
    "scrape:category": "node src/scrapeCategory.mjs",
    "scrape:category:debug": "node src/scrapeCategory.mjs --debug",
    "scrape:category:headed": "cross-env HEADED=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:longlogin": "cross-env HEADED=1 LOGIN_WAIT_MAX_MS=1800000 node src/scrapeCategory.mjs --debug",
    "scrape:category:snap": "cross-env HEADED=1 JSON_SNAPSHOT=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:discover": "cross-env HEADED=1 DISCOVER=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:caca": "cross-env HEADED=1 HUNT_LOG=1 NET_LOG=1 node src/scrapeCategory.mjs --hunt",
    "scrape:category:peek": "cross-env HEADED=1 ROUTER_PEEK_LEN=12000 node src/scrapeCategory.mjs --debug",
    "scrape:category:pdp": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs",
    "scrape:login": "cross-env HEADED=1 LOGIN_ONLY=1 node src/scrapeCategory.mjs",
    "scraper:worker": "node --import ./scripts/load-root-env.mjs src/scrapeCategory.mjs --debug",
    "scrape:cat:womenswear": "cross-env OUTPUT_DIR=output/categorias/womenswear-underwear node src/scrapeCategory.mjs",
    "scrape:cat:roupas-intimas": "cross-env OUTPUT_DIR=output/categorias/roupas-intimas-femininas CATEGORY_URL=https://shop.tiktok.com/br/c/women-s-underwear/842888?source=ecommerce_sitemap&enter_method=category_directory&first_entrance=ecommerce_category&first_entrance_position=bread_crumbs&first_entrance_tt_scene=seo node src/scrapeCategory.mjs",
    "scrape:categories:sample": "node scripts/scrape-both.mjs",
    "descobrir:categorias": "node scripts/descobrir-categorias.mjs",
    "coleta:todas": "node scripts/scrape-all-categories.mjs",
    "coleta:todas:reset": "node scripts/scrape-all-categories.mjs --reset",
    "coleta:todas:list": "node scripts/scrape-all-categories.mjs --list"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "prisma": "5.22.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@prisma/client": "5.22.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "jszip": "^3.10.1",
    "puppeteer": "^24.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.4"
  }
}
