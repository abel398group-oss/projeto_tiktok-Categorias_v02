{
  "name": "projeto-tiktok-categorias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run coleta:completa:db && npm run analytics:product-score",
    "test": "node --test test/scrape-regression.test.mjs",
    "validate:schemas": "node scripts/validate-output-schema.mjs",
    "test:spaces": "node --env-file=.env scripts/test-spaces-upload.mjs",
    "validate:db-vs-json": "node --env-file=.env scripts/validate-db-vs-json.mjs",
    "analytics:top-products": "node --env-file=.env scripts/analytics/top-products.mjs",
    "analytics:new-products": "node --env-file=.env scripts/analytics/new-products.mjs",
    "analytics:growth": "node --env-file=.env scripts/analytics/growth.mjs",
    "analytics:opportunities": "node --env-file=.env scripts/analytics/opportunities.mjs",
    "analytics:product-score": "node --env-file=.env scripts/analytics/product-score.mjs",
    "analytics:decision": "node --env-file=.env scripts/analytics/product-decision-cli.mjs",
    "analytics:scalable": "node --env-file=.env scripts/analytics/scalable-products-cli.mjs",
    "analytics:category-map": "node --env-file=.env scripts/analytics/category-map-cli.mjs",
    "analytics:api": "node --env-file=.env scripts/analytics/server.mjs",
    "api:dev": "npm run analytics:api",
    "frontend:dev": "cd frontend && npm run dev",
    "dev:all": "concurrently -n API,FRONT -c green,blue \"npm run api:dev\" \"npm run frontend:dev\"",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "db:import:output": "node scripts/import-output-to-db.mjs",
    "coleta": "node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:db": "node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node scripts/import-output-to-db.mjs",
    "coleta:uma": "node src/scrapeCategory.mjs",
    "coleta:uma:db": "node src/scrapeCategory.mjs && node scripts/import-output-to-db.mjs",
    "coleta:uma:completa": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs",
    "coleta:uma:completa:db": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs && node scripts/import-output-to-db.mjs",
    "coleta:completa": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:completa:db": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node scripts/import-output-to-db.mjs",
    "coleta:completa:login": "cross-env HEADED=1 PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs",
    "coleta:completa:login:db": "cross-env HEADED=1 PDP_GALLERY=1 PDP_GALLERY_MAX=25 node scripts/scrape-both.mjs && node scripts/consolidate-category-outputs.mjs && node scripts/import-output-to-db.mjs",
    "scrape:category": "node src/scrapeCategory.mjs",
    "scrape:category:debug": "node src/scrapeCategory.mjs --debug",
    "scrape:category:headed": "cross-env HEADED=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:longlogin": "cross-env HEADED=1 LOGIN_WAIT_MAX_MS=1800000 node src/scrapeCategory.mjs --debug",
    "scrape:category:snap": "cross-env HEADED=1 JSON_SNAPSHOT=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:discover": "cross-env HEADED=1 DISCOVER=1 node src/scrapeCategory.mjs --debug",
    "scrape:category:caca": "cross-env HEADED=1 HUNT_LOG=1 NET_LOG=1 node src/scrapeCategory.mjs --hunt",
    "scrape:category:peek": "cross-env HEADED=1 ROUTER_PEEK_LEN=12000 node src/scrapeCategory.mjs --debug",
    "scrape:category:pdp": "cross-env PDP_GALLERY=1 PDP_GALLERY_MAX=25 node src/scrapeCategory.mjs",
    "scrape:cat:womenswear": "cross-env OUTPUT_DIR=output/categorias/womenswear-underwear node src/scrapeCategory.mjs",
    "scrape:cat:roupas-intimas": "cross-env OUTPUT_DIR=output/categorias/roupas-intimas-femininas CATEGORY_URL=https://shop.tiktok.com/br/c/women-s-underwear/842888?source=ecommerce_sitemap&enter_method=category_directory&first_entrance=ecommerce_category&first_entrance_position=bread_crumbs&first_entrance_tt_scene=seo node src/scrapeCategory.mjs",
    "scrape:categories:sample": "node scripts/scrape-both.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@prisma/client": "5.22.0",
    "fastify": "^4.29.1",
    "puppeteer": "^24.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
