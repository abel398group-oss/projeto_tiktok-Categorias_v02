# Copiar para .env.production.local (ou .env.production) antes de `npm run build`.
# Esta chave fica dentro do bundle JS — não é segurança máxima; serve para modo simples (ver docs/DEPLOY-DROPLET-SIMPLES.md).

VITE_ANALYTICS_API_KEY=cole-o-mesmo-valor-de-ANALYTICS_API_KEY-da-raiz

# Explicitamente vazio: em produção o browser usa o mesmo domínio HTTPS;
# Nginx faz proxy de /analytics e /health para 127.0.0.1:3333
# VITE_API_URL=
